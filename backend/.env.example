# Скопируйте в backend/.env и впишите свои значения. .env не попадает в git.

# ИИ: любой сервис с OpenAI-совместимым API. Выберите ОДИН вариант.

# Вариант 1. Groq — бесплатно, ключ: https://console.groq.com/keys
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_...
OPENAI_MODEL=openai/gpt-oss-120b

# Вариант 2. OpenAI — платно, ключ: https://platform.openai.com/api-keys
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Секрет подписи JWT (обязательно, минимум 32 символа, любая случайная строка)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Необязательно, ниже значения по умолчанию
# DB_URL=jdbc:postgresql://localhost:5432/lekseradar
# DB_USER=lekseradar
# DB_PASSWORD=lekseradar
# CORS_ORIGINS=http://localhost:5173

# Ключ шифрования доступов к платформам (обязательно): openssl rand -base64 32
# Не терять: без него все подключения Canvas/Teams/itslearning/InSchool придётся делать заново
CREDENTIALS_KEY=

# Сервис сбора ДЗ (homework-collector): адрес и общий ключ. Локально ничего задавать не нужно:
# по умолчанию тот же ключ, что у collector в database/docker-compose.yml. В облаке — свой, одинаковый у обоих
# COLLECTOR_URL=http://localhost:8090
# COLLECTOR_KEY=local-dev-collector-key

# Свои Canvas вне *.instructure.com, через запятую
# CANVAS_HOSTS=canvas.uio.no
# Обновление ДЗ раз в 30 минут (false — выключить)
# SYNC_SCHEDULE_ENABLED=true
# Письмо ученику о несданном ДЗ со сроком в ближайшие 24 часа, раз в 15 минут (false — выключить). Нужна почта ниже
# REMINDERS_ENABLED=true

# Почта для кодов подтверждения регистрации (обязательно для регистрации).
# Gmail: включить двухэтапную проверку → https://myaccount.google.com/apppasswords → создать пароль приложения (16 букв)
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=
# Необязательно: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_FROM=адрес отправителя
# Только для разработки без почты: код печатается в лог бэкенда
# MAIL_DEV_LOG_CODES=true

# Google Classroom (необязательно). Google Cloud → Google Auth Platform → Clients → Web-клиент.
# Адрес возврата — каждый сайт из CORS_ORIGINS + /settings/platforms; его же вписать в Authorized redirect URIs
# GOOGLE_CLIENT_ID=…apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-…
