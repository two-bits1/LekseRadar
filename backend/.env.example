# Ключ OpenAI (обязательно): https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Секрет подписи JWT (обязательно, минимум 32 символа, любая случайная строка)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Необязательно, ниже значения по умолчанию
