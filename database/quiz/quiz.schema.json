{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lekseradar/quiz.schema.json",
  "title": "LekseRadar quiz",
  "description": "Формат квиза, который ИИ возвращает файлом JSON. Импорт в базу: SELECT import_quiz_json(<json>, <user_id>).",
  "type": "object",
  "required": ["subject", "topic", "level", "title", "questions"],
  "additionalProperties": false,
  "properties": {
    "subject":  {"type": "string", "minLength": 1, "maxLength": 100, "description": "Предмет, который выбрал пользователь, например \"Matematikk\""},
    "topic":    {"type": "string", "minLength": 1, "maxLength": 100, "description": "Тема квиза, например \"Lineære funksjoner\""},
    "level":    {"enum": ["beginner", "intermediate", "advanced"]},
    "language": {"type": "string", "default": "nb", "description": "Язык вопросов: nb, en, ru, uk ..."},
    "title":    {"type": "string", "minLength": 1, "maxLength": 200},
    "model":    {"type": "string", "description": "Какая модель сгенерировала (необязательно)"},
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["type", "question", "correct_answer"],
        "additionalProperties": false,
        "properties": {
          "type":     {"enum": ["single_choice", "multiple_choice", "text"]},
          "question": {"type": "string", "minLength": 1, "maxLength": 2000},
          "options":  {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 8,
                       "description": "Обязательно для single_choice и multiple_choice"},
          "correct_answer": {
            "description": "single_choice/text: строка; multiple_choice: массив строк из options",
            "oneOf": [{"type": "string", "minLength": 1}, {"type": "array", "items": {"type": "string"}, "minItems": 1}]
          },
          "explanation": {"type": "string", "maxLength": 1000, "description": "Почему ответ правильный (показать после ответа)"}
        }
      }
    }
  }
}
